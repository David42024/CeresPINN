    "models": [
      "ridge_trend",
      "ridge_trend_climate",
      "ridge_climate",
      "mlp_trend_climate",
      "mlp_climate",
      "mlp_detrended_climate"
    ],
    "features": {
      "trend": [
        "year"
      ],
      "climate": [
