      "alpha": 0.0001,
      "max_iter": 1000,
      "seeds": [
        0,
        1,
        42
      ],
      "scaling": "fit feature and target scalers on training rows only"
    },
    "uncertainty": "descriptive 95% moving-block bootstrap of complete test years, block length 3",
    "limitations": "Iowa only; eight shared weather years; no spatial buffer; retrospective after earlier outcome inspection; regional MLP is distinct from the national checkpoint; previously evaluated outcomes; convergence does not establish predictive validity or county calibration",
    "model_selection": "None based on evaluation outcomes; no algorithm or hyperparameter selection",
    "comparison": "Retrospective sensitivity to iteration ceiling; same folds, seeds, inputs and test years as the 300-iteration audit; no model selection."
