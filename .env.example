# FastAPI backend
FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT="8000"

# PostgreSQL / PostGIS
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/cerespinn"

# Frontend
VITE_API_BASE_URL="http://localhost:8000"
# Production rejects local/surrogate inference. Vite production builds enforce
# this even when the variable is omitted; keeping it explicit documents intent.
VITE_REQUIRE_REMOTE_PINN="false"

# FastAPI CORS (set on Render to the public Vercel URL)
FRONTEND_ORIGINS="http://localhost:3000"
# Optional, useful for this project's generated Vercel Preview URLs.
FRONTEND_ORIGIN_REGEX=""
CERESPINN_MODEL_DIR="backend/models"
CERESPINN_REQUIRE_MODEL="0"
CERESPINN_REQUIRE_DATABASE="0"
CERESPINN_REQUIRE_REAL_DATA="0"

# Gemini is backend-only. Never expose it as a VITE_* variable.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# ---------------------------------------------------------------------------
# Data extraction pipelines (backend.data)
# ---------------------------------------------------------------------------
# Offline planning mode (1 = no downloads, prints what would be fetched)
CERESPINN_DRY_RUN="1"
# Output root for downloaded datasets (default: backend/data)
CERESPINN_DATA_DIR=""
# USDA NASS QuickStats API key (https://quickstats.nass.usda.gov/api)
NASS_API_KEY=""
# Optional state filter for NASS (e.g. "IA" for Iowa, "" = all counties)
NASS_STATE_ALPHA=""
# Optional; override timeout / number of sampling points
CERESPINN_TIMEOUT="60"
