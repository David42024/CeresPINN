# FastAPI backend
FASTAPI_HOST="0.0.0.0"
FASTAPI_PORT="8000"

# PostgreSQL / PostGIS
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/cerespinn"

# Frontend
VITE_API_BASE_URL="http://localhost:8000"

# ---------------------------------------------------------------------------
# Data extraction pipelines (backend.data)
# ---------------------------------------------------------------------------
# Offline planning mode (1 = no downloads, prints what would be fetched)
CERESPINN_DRY_RUN="1"
# Output root for downloaded datasets (default: backend/data)
CERESPINN_DATA_DIR=""
# USDA NASS QuickStats API key (https://quickstats.nass.usda.gov/api)
NASS_API_KEY=""
# Optional state filter for NASS (e.g. "IA" for Iowa, "" = all counties)
NASS_STATE_ALPHA=""
# Optional; override timeout / number of sampling points
CERESPINN_TIMEOUT="60"
