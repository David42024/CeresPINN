""}, {"id": 17483889, "full_name": "Gary W. Marek", "first_name": "Gary W.", "last_name": "Marek", "is_active": false, "url_name": "_", "orcid_id": "0000-0001-8682-2539"}, {"id": 17483883, "full_name": "Karen S. Copeland", "first_name": "Karen S.", "last_name": "Copeland", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-2826-0280"}, {"id": 17483898, "full_name": "Terry A. Sr. Howell", "first_name": "Terry A. Sr.", "last_name": "Howell", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-5541-4564"}, {"id": 17483892, "full_name": "Paul D. Colaizzi", "first_name": "Paul D.", "last_name": "Colaizzi", "is_active": false, "url_name": "_", "orcid_id": "0000-0003-4251-8724"}, {"id": 17480730, "full_name": "David K. Brauer", "first_name": "David K.", "last_name": "Brauer", "is_active": false, "url_name": "_", "orcid_id": ""}, {"id": 17483886, "full_name": "Brice B. Ruthardt", "first_name": "Brice B.", "last_name": "Ruthardt", "is_active": false, "url_name": "_", "orcid_id": "0000-0002-6250-3952"}], "custom_fields": [{"name": "Data contact name", "value": "Evett, Steven R.", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "LastName, FirstName, M.I."}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Data contact email", "value": "steve.evett@usda.gov", "settings": {"placeholder": "Data contact email"}, "field_type": "email", "order": null, "is_mandatory": false}, {"name": "Publisher", "value": "Ag Data Commons", "settings": {"validations": {"min_length": 1, "max_length": 250}, "default_value": "Ag Data Commons"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Intended use", "value": "These data may be used to initialize, test and calibrate models of crop growth, water use (ET), and yield, and many be used to develop crop coefficients for use with a reference evapotranspiration model to estimate crop water use. Calculation of ET by soil water balance using these data necessarily depends on data on precipitation, irrigation, etc. from related datasets. Values of field ET so calculated may be used to verify that lysimeter ET data were or were not representative of the 4.4 ha fields within which each lysimeter was centered.", "settings": {"validations": {"min_length": 3, "max_length": 2000}, "placeholder": "Intended use"}, "field_type": "textarea", "order": null, "is_mandatory": false}, {"name": "Use limitations", "value": "The data pertain to the specific location, soil, climate, cultivar, and agronomic practices described in the data sets. Extrapolation to other climates, soils, cultivars, and practices should be done with care. Individual fields were square and somewhat larger than 210 m in width and length, so care should be used when combining satellite data with these data if satellite image pixels are large. The number of access tubes in the field soil surrounding each lysimeter was typically four in the first 20 years of lysimeter operation (approximately 1989 to 2008) and increased to eight in each field thereafter in order to improve representativity of field ET derived from neutron probe readings.", "settings": {"validations": {"min_length": 3, "max_length": 5000}, "placeholder": "Use limitations"}, "field_type": "textarea", "order": null, "is_mandatory": false}, {"name": "Temporal Extent Start Date", "value": "1989-01-01", "settings": {}, "field_type": "date", "order": null, "is_mandatory": false}, {"name": "Temporal Extent End Date", "value": "", "settings": {}, "field_type": "date", "order": null, "is_mandatory": false}, {"name": "Frequency", "value": ["irregular"], "settings": {"options": ["continual", "daily", "weekly", "fortnightly", "monthly", "quarterly", "biannually", "annually", "asNeeded", "irregular", "notPlanned", "unknown", "periodic", "semimonthly", "biennially"], "placeholder": "Frequency", "is_multiple": false}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "Theme", "value": ["Not speci