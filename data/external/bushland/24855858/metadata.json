vement and Maintenance", "005:031 - Forest and Rangeland Research", "005:032 - Forest Service Permanent Appropriations and Trust Funds", "005:033 - Land Acquisition", "005:034 - National Forest System", "005:035 - State and Private Forestry", "005:036 - Wildland Fire Management", "005:037 - Research and Education", "005:038 - Extension", "005:039 - Integrated Activities", "005:040 - National Research", "005:041 - Economic Research, Market Outlook, and Policy Analysis", "005:042 - Agricultural Estimates", "005:043 - Census of Agriculture", "005:044 - Grain Regulatory Program", "005:045 - Packers and Stockyards Program", "005:046 - Inspection and Grading of Farm Products", "005:047 - Marketing Services", "005:048 - Payments to States and Possessions", "005:049 - Perishable Agricultural Commodities Act", "005:050 - Commodity Purchases", "005:051 - Safeguarding and Emergency Preparedness/Response", "005:052 - Safe Trade and International Technical Assistance", "005:053 - Animal Welfare", "005:054 - Child Nutrition Programs", "005:055 - Commodity Assistance Programs", "005:056 - Supplemental Nutrition Assistance Program", "005:057 - Center for Nutrition Policy and Promotion", "005:058 - Food Safety and Inspection", "005:059 - Management Activities", "005:000 - (Primary Program Not Available)"], "placeholder": "OMB Program Code", "is_multiple": true}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "ARS National Program Number", "value": ["211"], "settings": {"options": ["101", "103", "104", "106", "107", "108", "211", "212", "215", "216", "301", "303", "304", "305", "306", "Other"], "placeholder": "ARS National Program Number", "is_multiple": true}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "ARIS Log Number", "value": "", "settings": {"validations": {"min_length": 1, "max_length": 250}, "placeholder": "ARIS Log Number"}, "field_type": "text", "order": null, "is_mandatory": false}, {"name": "Primary article PubAg Handle", "value": ["https://handle.nal.usda.gov/10113/7972952"], "settings": {"placeholder": "LEAVE THIS FIELD BLANK - ADMINISTRATIVE USE ONLY", "is_multiple": true}, "field_type": "url", "order": null, "is_mandatory": false}, {"name": "Pending citation", "value": ["No"], "settings": {"options": ["Yes", "No"], "default_value": ["No"], "is_multiple": false}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "Related material without URL", "value": "", "settings": {"validations": {"min_length": 10, "max_length": 2000}, "placeholder": "Related material without URL"}, "field_type": "textarea", "order": null, "is_mandatory": false}, {"name": "Public Access Level", "value": ["Public"], "settings": {"options": ["Public"], "default_value": ["Public"], "is_multiple": false}, "field_type": "dropdown", "order": null, "is_mandatory": false}, {"name": "Preferred dataset citation", "value": "Evett, Steven R.; Marek, Gary W.; Copeland, Karen S.; Howell, Terry A. Sr.; Colaizzi, Paul D.; Brauer, David K.; Ruthardt, Brice B. (2022). Soil Water Content Data for The Bushland, Texas Large Weighing Lysimeter Experiments. Ag Data Commons. https://doi.org/10.15482/USDA.ADC/1526332", "settings": {"validations": {"min_length": 3, "max_length": 10000}, "placeholder": "Preferred dataset citation"}, "field_type": "textarea", "order": null, "is_mandatory": false}], "figshare_url": "https://agdatacommons.nal.usda.gov/articles/dataset/Soil_Water_Content_Data_for_The_Bushland_Texas_Large_Weighing_Lysimeter_Experiments/24855858", "download_disabled": false, "description": "<p>This dataset contains soil water content data developed from neutron probe readings taken in access tubes in each of the four large, precision weighing lysimeters and in the fields surrounding each lysimeter at the USDA-ARS Conservation and Production Laboratory (CPRL), Soil and Water Management Research Unit (SWMRU), Bushland, Texas (Lat. 35.186714\u00b0, Long. -102.094189\u00b0, elevation 1170 m above MSL) beginning in 1989. Readings were taken periodically with a field-calibrated neutron probe at depths from 10 cm to 230 cm (maximum of 190 cm depth in the lysimeters) in 20-cm depth increments. Periods between readings were typically one to two weeks, sometimes longer according to experimental design and need for data. Field calibrations in the Pullman soil series were done every few years. Calibrations typically produced a regression equation with RMSE <= 0.01 m<sup>3</sup> m<sup>-3</sup>. Data were used to guide irrigation scheduling to achieve full or deficit irrigation as required by the experimental design. Data may be used to calculate the soil profile water content in mm of water from the surface to the maximum depth of reading. Profile water content differences between reading times in the same access tube are considered the change in soil water storage during the period in question and may be used to compute evapotranspiration (ET) using the soil water balance equation: ET = (change in storage + P + I + F + R, where P is precipitation during the period, I is irrigation during the period, F is soil water flux (drainage) out of the bottom of the soil profile during the period, and R is the sum of runon and runoff during the period. Typically, R is taken as zero because the fields were furrow diked to prevent runon and runoff during most of each growing season.</p>\n<p>See the README for descriptions of each data file.</p>", "funding": "USDA-ARS: 3090-13000-015-00D", "funding_list": [{"id": 23999979, "title": "USDA-ARS: 3090-13000-015-00D", "grant_code": "", "funder_name": null, "is_user_defined": 1}], "version": 1, "status": "public", "size": 22591951, "created_date": "2024-02-15T20:31:33Z", "modified_date": "2025-11-21T23:17:57Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 2, "name": "CC0", "url": "https://creativecommons.org/publicdomain/zero/1.0/"}, "tag