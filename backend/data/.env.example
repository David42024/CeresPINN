# CeresPINN - Data extraction credentials (LOCAL ONLY, never commit)
#
# Copy this file to `backend/data/.env` and fill in your key:
#     cp backend/data/.env.example backend/data/.env
# or on Windows PowerShell:
#     Copy-Item backend/data/.env.example backend/data/.env
#
# Only NASS requires a key. CHIRPS and NEX-GDDP are free/public HTTPS.

# USDA NASS QuickStats API key.
# Get it free at: https://quickstats.nass.usda.gov/api  ->  "Request an api key here"
NASS_API_KEY=